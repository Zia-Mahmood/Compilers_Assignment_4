digraph G {
    subgraph cluster_conditional {
        label = "conditional";
        node [shape=box];
        node0 [label="BB0\n  %2 = alloca i32, align 4\n  %3 = alloca i32, align 4\n  store i32 %0, ptr %3, align 4\n  %4 = load i32, ptr %3, align 4\n  %5 = icmp sgt i32 %4, 0\n  br i1 %5, label %6, label %7"];
        node1 [label="BB1\n  store i32 1, ptr %2, align 4\n  br label %8"];
        node2 [label="BB2\n  store i32 0, ptr %2, align 4\n  br label %8"];
        node3 [label="BB3\n  %9 = load i32, ptr %2, align 4\n  ret i32 %9"];
        ENTRY [label="ENTRY", shape=ellipse];
        EXIT [label="EXIT", shape=ellipse];
    }
    ENTRY -> node0;
    node0 -> node1 [label="true"];
    node0 -> node2 [label="false"];
    node1 -> node3;
    node2 -> node3;
    node3 -> EXIT;
}

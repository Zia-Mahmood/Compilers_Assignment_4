digraph G {
    subgraph cluster_loop_with_conditional {
        label = "loop_with_conditional";
        node [shape=box];
        node0 [label="BB0\n  %2 = alloca i32, align 4\n  %3 = alloca i32, align 4\n  %4 = alloca i32, align 4\n  store i32 %0, ptr %2, align 4\n  store i32 0, ptr %3, align 4\n  store i32 0, ptr %4, align 4\n  br label %5"];
        node1 [label="BB1\n  %6 = load i32, ptr %4, align 4\n  %7 = load i32, ptr %2, align 4\n  %8 = icmp slt i32 %6, %7\n  br i1 %8, label %9, label %21"];
        node2 [label="BB2\n  %10 = load i32, ptr %4, align 4\n  %11 = srem i32 %10, 2\n  %12 = icmp eq i32 %11, 0\n  br i1 %12, label %13, label %17"];
        node6 [label="BB6\n  %22 = load i32, ptr %3, align 4\n  ret i32 %22"];
        node3 [label="BB3\n  %14 = load i32, ptr %4, align 4\n  %15 = load i32, ptr %3, align 4\n  %16 = add nsw i32 %15, %14\n  store i32 %16, ptr %3, align 4\n  br label %17"];
        node4 [label="BB4\n  br label %18"];
        node5 [label="BB5\n  %19 = load i32, ptr %4, align 4\n  %20 = add nsw i32 %19, 1\n  store i32 %20, ptr %4, align 4\n  br label %5, !llvm.loop !6"];
        ENTRY [label="ENTRY", shape=ellipse];
        EXIT [label="EXIT", shape=ellipse];
    }
    ENTRY -> node0;
    node0 -> node1;
    node1 -> node2 [label="true"];
    node1 -> node6 [label="false"];
    node2 -> node3 [label="true"];
    node2 -> node4 [label="false"];
    node6 -> EXIT;
    node3 -> node4;
    node4 -> node5;
    node5 -> node1;
}

digraph G {
    subgraph cluster_main {
        label = "main";
        node [shape=box];
        node0 [label="BB0\n  %1 = alloca i32, align 4\n  store i32 0, ptr %1, align 4\n  %2 = call i32 @linear_flow()\n  %3 = call i32 @conditional(i32 noundef 5)\n  %4 = call i32 @loop(i32 noundef 10)\n  %5 = call i32 @nested_conditional(i32 noundef 15)\n  %6 = call i32 @switch_case(i32 noundef 2)\n  call void @empty_function()\n  %7 = call i32 @multiple_returns(i32 noundef 0)\n  %8 = call i32 @loop_with_conditional(i32 noundef 8)\n  %9 = call i32 @while_with_break(i32 noundef 10)\n  %10 = call i32 @unreachable_code()\n  %11 = call i32 @nested_loops(i32 noundef 3)\n  %12 = call i32 @goto_test(i32 noundef -5)\n  %13 = call i32 @recursive(i32 noundef 4)\n  %14 = call i32 @empty_loop(i32 noundef 5)\n  ret i32 0"];
        ENTRY [label="ENTRY", shape=ellipse];
        EXIT [label="EXIT", shape=ellipse];
    }
    ENTRY -> node0;
